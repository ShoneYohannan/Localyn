# Localyn Environment Configuration
# Copy this file to .env and adjust variables as needed

# Application & Security
ENVIRONMENT=development
SECRET_KEY=localyn-super-secret-dev-key-change-in-prod-xyz-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local dev default: SQLite (zero-config)
DATABASE_URL=sqlite:///./localyn.db
# Production / Docker Compose default:
# DATABASE_URL=postgresql://localyn:localynpass@postgres:5432/localyn_db

# Redis & Background Workers
REDIS_URL=redis://localhost:6379/0

# Google Places API (For live competitor discovery & benchmarking)
# Leave blank to operate in simulated Demo Mode with high-fidelity realistic data
GOOGLE_PLACES_API_KEY=

# Google Business Profile OAuth & API
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/integrations/google/callback

# Google Gemini AI (For deep recommendation generation and review response synthesis)
# Leave blank to operate in heuristic reasoning fallback mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Frontend URL & CORS
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
